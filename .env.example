# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Databases ----
# Two logical databases. Same cluster is fine; the DB name in the URI is what matters.
CRM_DB_URI=mongodb://127.0.0.1:27017/crm_db
HRM_DB_URI=mongodb://127.0.0.1:27017/hrm_db

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=crmhrm_rt

# ---- CORS / cookies ----
CLIENT_ORIGINS=http://localhost:5173
# In production (SPA on a different domain to the API) set:
#   COOKIE_SECURE=true  COOKIE_SAMESITE=none  COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- Uploads ----
# Files are stored on Cloudinary (local disk doesn't survive a redeploy on
# most hosts). UPLOAD_DIR/local disk is only read for records uploaded before
# Cloudinary was configured.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# ---- Reverse geocoding (GPS attendance) ----
GEOCODE_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODE_API_KEY=

# ---- Email (optional in dev — messages are logged) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CRM+HRM <no-reply@localhost>

# ---- Customer email via Resend (invoices/receipts, CRM "Emails" tab) ----
# Per-brand key/from pair takes priority; falls back to the generic pair
# below when unset for that brand. Leave both empty to disable sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_KEY_AJCL=
RESEND_FROM_EMAIL_AJCL=
RESEND_API_KEY_QSA=
RESEND_FROM_EMAIL_QSA=
RESEND_API_KEY_NTP=
RESEND_FROM_EMAIL_NTP=

# ---- Seed (scripts/seed.js) ----
SEED_ADMIN_EMAIL=admin@crmhrm.local
SEED_ADMIN_PASSWORD=

# ---- External source databases (READ-ONLY) ----
# Each brand's own live production app has its own MongoDB. Set any of these
# to let services/crm/externalSync.service.js mirror real customers and
# transactions into this platform's CRM (POST /api/crm/sync/{ajcl,quickship,tradies}).
# Leave a var blank to disable sync for that brand — nothing else requires it.
AJCL_SOURCE_DB_URI=
QUICKSHIP_SOURCE_DB_URI=
TRADIES_SOURCE_DB_URI=
